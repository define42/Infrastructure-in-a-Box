#!/bin/sh
set -eu
trap 'status=$?; [ "$status" -eq 0 ] || echo "E2E FAIL: DHCP hook ($1), status $status"' EXIT
case "$1" in
    deconfig)
        ip addr flush dev "$interface"
        rm -f /run/lease-address
        ;;
    bound|renew)
        case "$ip" in
            192.168.77.10[0-9]|192.168.77.110) ;;
            *) echo "unexpected DHCP address: $ip"; exit 1 ;;
        esac
        [ "$subnet" = 255.255.255.0 ]
        [ "$dns" = 192.168.77.1 ]
        [ "$domain" = home.arpa ]
        [ "$search" = home.arpa ]
        [ -z "${router:-}" ]
        ip addr replace "$ip/24" dev "$interface"
        printf 'nameserver %s\nsearch %s\n' "$dns" "$search" > /etc/resolv.conf
        printf '%s\n' "$ip" > /run/lease-address
        touch "/run/$1"
        ;;
esac
